# Database
DATABASE_URL="postgresql://postgres:root@localhost:5432/voting_system?schema=public"

# JWT
JWT_SECRET="voting-system-jwt-secret-key-2024"

# Application
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:5174"

# ===== CLOUDINARY CONFIGURATION =====
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ===== EMAIL CONFIGURATION =====

# Gmail SMTP (Real Emails)
# For school projects: Use regular Gmail password (no 2FA required)
# For production: Use App Passwords with 2FA enabled
GMAIL_USER="your-email@gmail.com"
GMAIL_PASSWORD="your-gmail-password" 