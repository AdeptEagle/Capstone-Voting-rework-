{
  "name": "voting-system-backend",
  "version": "1.0.0",
  "description": "NestJS backend for voting system",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "seed:test": "ts-node prisma/seed.ts",
    "seed:db": "ts-node prisma/seed.ts",
    "seed:ballot": "ts-node src/scripts/seed-ballot-test-data.ts",
    "seed:templates": "ts-node scripts/seed-ballot-templates.ts",
    "test:template": "ts-node scripts/test-template-creation.ts",
    "test:department": "ts-node scripts/test-department-template.ts",
    "check:template-positions": "ts-node scripts/check-template-positions.ts",
    "compare:templates": "ts-node scripts/compare-template-sources.ts",
    "diagnose:templates": "ts-node scripts/diagnose-template-issue.ts",
    "cleanup:duplicates": "ts-node scripts/cleanup-duplicate-positions.ts",
    "ensure:templates": "ts-node scripts/ensure-templates.ts",
    "test:auto-init": "ts-node scripts/test-auto-initialization.ts",
    "verify:startup": "ts-node scripts/verify-startup.ts",
    "clean:system": "ts-node scripts/clean-system.ts",
    "seed:candidates": "ts-node scripts/seed-candidates-for-positions.ts",
    "test:positions": "ts-node scripts/test-position-initialization.ts",
    "demo:seed": "ts-node scripts/demo-seed-positions-and-candidates.ts",
    "verify:demo": "ts-node scripts/verify-demo-system.ts",
    "ensure:candidates": "ts-node scripts/ensure-candidates.ts",
    "setup:other": "ts-node scripts/setup-other-system.ts",
    "test:cloudinary": "ts-node src/scripts/test-cloudinary.ts",
    "setup:super-admin": "ts-node src/scripts/create-super-admin.ts",
    "create:superadmin": "ts-node src/scripts/create-default-superadmin.ts",
    "setup:db": "node scripts/setup-database.js",
    "init:project": "npm install && npm run setup:db && npm run start:dev",
    "deploy:init": "npm run db:push && npm run db:seed && npm run ensure:templates && npm run demo:seed && npm run ensure:candidates && npm run start:prod",
    "deploy:demo": "npm run db:push && npm run db:seed && npm run demo:seed && npm run ensure:candidates && npm run start:prod"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/websockets": "^10.0.0",
    "@prisma/client": "^5.7.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "form-data": "^4.0.4",
    "moment-timezone": "^0.6.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io-client": "^4.8.1",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-local": "^1.0.38",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^5.7.1",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
