generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             String       @id @db.VarChar(50)
  Admin_Username String       @unique @map("admin_username") @db.VarChar(255)
  Admin_Email    String?      @unique @map("admin_email") @db.VarChar(255)
  password       String       @db.VarChar(255)
  role           Role         @default(ADMIN)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  courses        Course[]
  departments    Department[]
  elections      Election[]

  @@map("admins")
}

model Department {
  id                     String      @id @db.VarChar(50)
  Department_Name        String      @map("department_name") @db.VarChar(255)
  Department_Description String?     @map("department_description")
  createdBy              String
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")
  deletedAt              DateTime?   @map("deleted_at")
  isDeleted              Boolean     @default(false) @map("is_deleted")
  candidates             Candidate[]
  courses                Course[]
  admin                  Admin       @relation(fields: [createdBy], references: [id])
  voters                 Voter[]

  @@map("departments")
}

model Course {
  id                 String      @id @db.VarChar(50)
  Course_Name        String      @map("course_name") @db.VarChar(255)
  Course_Code        String      @unique @map("course_code") @db.VarChar(50)
  Course_Description String?     @map("course_description")
  departmentId       String
  createdBy          String
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  deletedAt          DateTime?   @map("deleted_at")
  isDeleted          Boolean     @default(false) @map("is_deleted")
  candidates         Candidate[]
  admin              Admin       @relation(fields: [createdBy], references: [id])
  department         Department  @relation(fields: [departmentId], references: [id])
  voters             Voter[]

  @@map("courses")
}

model Position {
  id                   String             @id @db.VarChar(50)
  Position_Title       String             @map("position_title") @db.VarChar(255)
  Position_Description String?            @map("position_description")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  voteLimit            Int                @default(1)
  displayOrder         Int                @default(0)
  deletedAt            DateTime?          @map("deleted_at")
  isDeleted            Boolean            @default(false) @map("is_deleted")
  candidates           Candidate[]
  electionPositions    ElectionPosition[]
  votes                Vote[]

  @@map("positions")
}

model Candidate {
  id                  String              @id @db.VarChar(50)
  Candidate_Name      String              @map("candidate_name") @db.VarChar(255)
  Candidate_Email     String              @map("candidate_email") @db.VarChar(255)
  Candidate_StudentId String              @unique @map("candidate_student_id") @db.VarChar(50)
  photo               String?             @db.VarChar(255)
  manifesto           String?
  positionId          String
  departmentId        String?
  courseId            String?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  deletedAt           DateTime?           @map("deleted_at")
  isDeleted           Boolean             @default(false) @map("is_deleted")
  course              Course?             @relation(fields: [courseId], references: [id])
  department          Department?         @relation(fields: [departmentId], references: [id])
  position            Position            @relation(fields: [positionId], references: [id])
  electionCandidates  ElectionCandidate[]
  votes               Vote[]

  @@map("candidates")
}

model Voter {
  id              String      @id @db.VarChar(50)
  Voter_Name      String      @map("voter_name") @db.VarChar(255)
  Voter_Email     String      @unique @map("voter_email") @db.VarChar(255)
  Voter_StudentId String      @unique @map("voter_student_id") @db.VarChar(50)
  password        String?     @db.VarChar(255)
  departmentId    String
  courseId        String
  hasVoted        Boolean     @default(false)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  deletedAt       DateTime?   @map("deleted_at")
  isDeleted       Boolean     @default(false) @map("is_deleted")
  auditLogs       AuditLog[]
  course          Course      @relation(fields: [courseId], references: [id])
  department      Department  @relation(fields: [departmentId], references: [id])
  votes           Vote[]

  @@map("voters")
}

model Election {
  id                   String              @id @db.VarChar(50)
  Election_Title       String              @map("election_title") @db.VarChar(255)
  Election_Description String?             @map("election_description")
  startDate            DateTime
  endDate              DateTime
  isActive             Boolean             @default(false)
  createdBy            String
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  status               String              @default("draft") @db.VarChar(50)
  deletedAt            DateTime?           @map("deleted_at")
  isDeleted            Boolean             @default(false) @map("is_deleted")
  auditLogs            AuditLog[]
  electionCandidates   ElectionCandidate[]
  electionPositions    ElectionPosition[]
  admin                Admin               @relation(fields: [createdBy], references: [id])
  votes                Vote[]

  @@map("elections")
}

model Vote {
  id               String    @id @db.VarChar(50)
  voterId          String
  candidateId      String
  createdAt        DateTime  @default(now()) @map("created_at")
  auditHash        String?   @db.VarChar(255)
  electionId       String
  ipAddress        String?   @db.VarChar(45)
  positionId       String
  sessionId        String?   @db.VarChar(255)
  userAgent        String?
  verificationCode String?   @db.VarChar(255)
  candidate        Candidate @relation(fields: [candidateId], references: [id])
  election         Election  @relation(fields: [electionId], references: [id])
  position         Position  @relation(fields: [positionId], references: [id])
  voter            Voter     @relation(fields: [voterId], references: [id])

  @@unique([voterId, electionId, positionId, candidateId])
  @@map("votes")
}

model ElectionPosition {
  electionId String
  positionId String
  createdAt  DateTime @default(now()) @map("created_at")
  id         String   @id @db.VarChar(50)
  election   Election @relation(fields: [electionId], references: [id])
  position   Position @relation(fields: [positionId], references: [id])

  @@unique([electionId, positionId])
  @@map("election_positions")
}

model ElectionCandidate {
  electionId  String
  candidateId String
  createdAt   DateTime  @default(now()) @map("created_at")
  id          String    @id @db.VarChar(50)
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  election    Election  @relation(fields: [electionId], references: [id])

  @@unique([electionId, candidateId])
  @@map("election_candidates")
}

model PasswordResetToken {
  id               String   @id @db.VarChar(50)
  ResetToken_Email String   @unique @map("reset_token_email") @db.VarChar(255)
  token            String   @unique @db.VarChar(255)
  expiresAt        DateTime
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model AuditLog {
  id         String    @id @db.VarChar(50)
  eventType  String    @db.VarChar(50)
  timestamp  DateTime  @default(now())
  userId     String?   @db.VarChar(50)
  electionId String?   @db.VarChar(50)
  action     String    @db.VarChar(255)
  details    Json?
  metadata   Json?
  severity   String    @db.VarChar(20)
  createdAt  DateTime  @default(now()) @map("created_at")
  election   Election? @relation(fields: [electionId], references: [id])
  user       Voter?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum Role {
  SUPERADMIN
  ADMIN
}
