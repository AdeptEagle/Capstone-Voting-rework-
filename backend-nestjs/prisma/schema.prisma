generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id              String           @id @db.VarChar(50)
  Admin_Username  String           @unique @map("admin_username") @db.VarChar(255)
  Admin_Email     String?          @unique @map("admin_email") @db.VarChar(255)
  password        String           @db.VarChar(255)
  role            Role             @default(ADMIN)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  loginLogs       AdminLoginLog[]
  ballotTemplates BallotTemplate[]
  ballots         Ballot[]
  courses         Course[]
  departments     Department[]

  @@map("admins")
}

model Department {
  id                     String      @id @db.VarChar(50)
  Department_Name        String      @map("department_name") @db.VarChar(255)
  Department_Description String?     @map("department_description")
  createdBy              String      @db.VarChar(50)
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")
  deletedAt              DateTime?   @map("deleted_at")
  isDeleted              Boolean     @default(false) @map("is_deleted")
  candidates             Candidate[]
  courses                Course[]
  admin                  Admin       @relation(fields: [createdBy], references: [id])
  voters                 Voter[]

  @@map("departments")
}

model Course {
  id                 String      @id @db.VarChar(50)
  Course_Name        String      @map("course_name") @db.VarChar(255)
  Course_Code        String      @unique @map("course_code") @db.VarChar(50)
  Course_Description String?     @map("course_description")
  departmentId       String      @db.VarChar(50)
  createdBy          String      @db.VarChar(50)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  deletedAt          DateTime?   @map("deleted_at")
  isDeleted          Boolean     @default(false) @map("is_deleted")
  candidates         Candidate[]
  admin              Admin       @relation(fields: [createdBy], references: [id])
  department         Department  @relation(fields: [departmentId], references: [id])
  voters             Voter[]

  @@map("courses")
}

model Position {
  id                   String                @id @db.VarChar(50)
  Position_Title       String                @map("position_title") @db.VarChar(255)
  Position_Description String?               @map("position_description")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  deletedAt            DateTime?             @map("deleted_at")
  isDeleted            Boolean               @default(false) @map("is_deleted")
  displayOrder         Int                   @default(0)
  voteLimit            Int                   @default(1)
  ballot_candidates    BallotCandidate[]
  ballotPositions      BallotPosition[]
  resultDetails        BallotResultDetails[]
  candidates           Candidate[]
  votes                Vote[]

  @@map("positions")
}

model PartyList {
  id          String      @id @db.VarChar(50)
  name        String      @db.VarChar(255)
  description String?
  color       String?     @db.VarChar(7)
  logo        String?     @db.VarChar(255)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")
  isDeleted   Boolean     @default(false) @map("is_deleted")
  candidates  Candidate[]

  @@map("party_lists")
}

model Candidate {
  id                  String                @id @db.VarChar(50)
  Candidate_Name      String                @map("candidate_name") @db.VarChar(255)
  Candidate_Email     String                @map("candidate_email") @db.VarChar(255)
  Candidate_StudentId String                @unique @map("candidate_student_id") @db.VarChar(50)
  photo               String?               @db.VarChar(255)
  manifesto           String?
  positionId          String                @db.VarChar(50)
  departmentId        String?               @db.VarChar(50)
  courseId            String?               @db.VarChar(50)
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  deletedAt           DateTime?             @map("deleted_at")
  isDeleted           Boolean               @default(false) @map("is_deleted")
  partyListId         String?               @map("party_list_id") @db.VarChar(50)
  party_list_name     String?               @map("party_list_name") @db.VarChar(255)
  ballotCandidates    BallotCandidate[]
  resultDetails       BallotResultDetails[]
  votes               Vote[]
  course              Course?               @relation(fields: [courseId], references: [id])
  department          Department?           @relation(fields: [departmentId], references: [id])
  partyList           PartyList?            @relation(fields: [partyListId], references: [id])
  position            Position              @relation(fields: [positionId], references: [id])

  @@map("candidates")
}

model Voter {
  id              String              @id @db.VarChar(50)
  Voter_Name      String              @map("voter_name") @db.VarChar(255)
  Voter_Email     String              @unique @map("voter_email") @db.VarChar(255)
  Voter_StudentId String              @unique @map("voter_student_id") @db.VarChar(50)
  password        String?             @db.VarChar(255)
  departmentId    String?             @db.VarChar(50)
  courseId        String?             @db.VarChar(50)
  hasVoted        Boolean             @default(false)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  deletedAt       DateTime?           @map("deleted_at")
  isDeleted       Boolean             @default(false) @map("is_deleted")
  auditLogs       AuditLog[]
  ballotHistory   UserBallotHistory[]
  loginLogs       UserLoginLog[]
  course          Course?             @relation(fields: [courseId], references: [id])
  department      Department?         @relation(fields: [departmentId], references: [id])
  votes           Vote[]

  @@map("voters")
}

model Vote {
  id               String    @id @db.VarChar(50)
  voterId          String    @db.VarChar(50)
  candidateId      String    @db.VarChar(50)
  positionId       String    @db.VarChar(50)
  createdAt        DateTime  @default(now()) @map("created_at")
  auditHash        String?   @db.VarChar(255)
  ipAddress        String?   @db.VarChar(45)
  sessionId        String?   @db.VarChar(255)
  userAgent        String?
  verificationCode String?   @db.VarChar(255)
  ballotId         String?   @db.VarChar(50)
  ballot           Ballot?   @relation(fields: [ballotId], references: [id])
  candidate        Candidate @relation(fields: [candidateId], references: [id])
  position         Position  @relation(fields: [positionId], references: [id])
  voter            Voter     @relation(fields: [voterId], references: [id])

  @@unique([voterId, positionId, candidateId])
  @@map("votes")
}

model PasswordResetToken {
  id               String   @id @db.VarChar(50)
  ResetToken_Email String   @unique @map("reset_token_email") @db.VarChar(255)
  token            String   @unique @db.VarChar(255)
  expiresAt        DateTime
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @db.VarChar(50)
  eventType  String   @db.VarChar(50)
  timestamp  DateTime @default(now())
  userId     String?  @db.VarChar(50)
  action     String   @db.VarChar(255)
  details    Json?
  metadata   Json?
  severity   String   @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  user       Voter?   @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Ballot {
  id                         String                @id @db.VarChar(50)
  Ballot_Title               String                @map("ballot_title") @db.VarChar(255)
  Ballot_Description         String?               @map("ballot_description")
  Ballot_StartDate           DateTime              @map("ballot_start_date")
  Ballot_EndDate             DateTime              @map("ballot_end_date")
  Ballot_Status              BallotStatus          @default(DRAFT) @map("ballot_status")
  Ballot_IsActive            Boolean               @default(false) @map("ballot_is_active")
  Ballot_MaxVotesPerUser     Int                   @default(1) @map("ballot_max_votes_per_user")
  Ballot_AllowMultipleVotes  Boolean               @default(false) @map("ballot_allow_multiple_votes")
  Ballot_RequireAllPositions Boolean               @default(true) @map("ballot_require_all_positions")
  Ballot_ShowResults         Boolean               @default(true) @map("ballot_show_results")
  Ballot_ShowResultsAfter    DateTime?             @map("ballot_show_results_after")
  Ballot_ShowLiveResults     Boolean               @default(true) @map("ballot_show_live_results")
  Ballot_AllowAbstain        Boolean               @default(false) @map("ballot_allow_abstain")
  Ballot_CreatedBy           String                @map("ballot_created_by") @db.VarChar(50)
  Ballot_CreatedAt           DateTime              @default(now()) @map("ballot_created_at")
  Ballot_UpdatedAt           DateTime              @updatedAt @map("ballot_updated_at")
  Ballot_DeletedAt           DateTime?             @map("ballot_deleted_at")
  Ballot_IsDeleted           Boolean               @default(false) @map("ballot_is_deleted")
  ballotCandidates           BallotCandidate[]
  ballotPositions            BallotPosition[]
  resultDetails              BallotResultDetails[]
  results                    BallotResults?
  votes                      Vote[]
  createdByAdmin             Admin                 @relation(fields: [Ballot_CreatedBy], references: [id])
  userHistory                UserBallotHistory[]

  @@map("ballots")
}

model UserBallotHistory {
  id                             String    @id @db.VarChar(50)
  UserBallotHistory_UserId       String    @map("user_ballot_history_user_id") @db.VarChar(50)
  UserBallotHistory_BallotId     String    @map("user_ballot_history_ballot_id") @db.VarChar(50)
  UserBallotHistory_VotedAt      DateTime? @map("user_ballot_history_voted_at")
  UserBallotHistory_VoteCount    Int       @default(0) @map("user_ballot_history_vote_count")
  UserBallotHistory_IsCompleted  Boolean   @default(false) @map("user_ballot_history_is_completed")
  UserBallotHistory_LastAccessed DateTime  @default(now()) @map("user_ballot_history_last_accessed")
  ballot                         Ballot    @relation(fields: [UserBallotHistory_BallotId], references: [id])
  user                           Voter     @relation(fields: [UserBallotHistory_UserId], references: [id])

  @@unique([UserBallotHistory_UserId, UserBallotHistory_BallotId], map: "user_ballot_history_user_ballot_history_user_id_user_ballot_his")
  @@map("user_ballot_history")
}

model BallotPosition {
  id                          String   @id @db.VarChar(50)
  BallotPosition_BallotId     String   @map("ballot_position_ballot_id") @db.VarChar(50)
  BallotPosition_PositionId   String   @map("ballot_position_position_id") @db.VarChar(50)
  BallotPosition_DisplayOrder Int      @default(0) @map("ballot_position_display_order")
  BallotPosition_IsRequired   Boolean  @default(true) @map("ballot_position_is_required")
  ballot                      Ballot   @relation(fields: [BallotPosition_BallotId], references: [id])
  position                    Position @relation(fields: [BallotPosition_PositionId], references: [id])

  @@unique([BallotPosition_BallotId, BallotPosition_PositionId], map: "ballot_positions_ballot_position_ballot_id_ballot_position_posi")
  @@map("ballot_positions")
}

model BallotCandidate {
  id                          String    @id @db.VarChar(50)
  BallotCandidate_BallotId    String    @map("ballot_candidate_ballot_id") @db.VarChar(50)
  BallotCandidate_CandidateId String    @map("ballot_candidate_candidate_id") @db.VarChar(50)
  BallotCandidate_PositionId  String    @map("ballot_candidate_position_id") @db.VarChar(50)
  BallotCandidate_IsActive    Boolean   @default(true) @map("ballot_candidate_is_active")
  ballot                      Ballot    @relation(fields: [BallotCandidate_BallotId], references: [id])
  candidate                   Candidate @relation(fields: [BallotCandidate_CandidateId], references: [id])
  positions                   Position  @relation(fields: [BallotCandidate_PositionId], references: [id])

  @@unique([BallotCandidate_BallotId, BallotCandidate_CandidateId], map: "ballot_candidates_ballot_candidate_ballot_id_ballot_candidate_c")
  @@map("ballot_candidates")
}

model BallotResults {
  id                         String   @id @db.VarChar(50)
  BallotResults_BallotId     String   @unique @map("ballot_results_ballot_id") @db.VarChar(50)
  BallotResults_TotalVotes   Int      @default(0) @map("ballot_results_total_votes")
  BallotResults_TotalVoters  Int      @default(0) @map("ballot_results_total_voters")
  BallotResults_VoterTurnout Float    @default(0) @map("ballot_results_voter_turnout")
  BallotResults_LastUpdated  DateTime @default(now()) @map("ballot_results_last_updated")
  BallotResults_IsFinal      Boolean  @default(false) @map("ballot_results_is_final")
  ballot                     Ballot   @relation(fields: [BallotResults_BallotId], references: [id])
  resultDetails               BallotResultDetails[]

  @@map("ballot_results")
}

model BallotResultDetails {
  id                              String    @id @db.VarChar(50)
  BallotResultDetails_BallotId    String    @map("ballot_result_details_ballot_id") @db.VarChar(50)
  BallotResultDetails_PositionId  String    @map("ballot_result_details_position_id") @db.VarChar(50)
  BallotResultDetails_CandidateId String    @map("ballot_result_details_candidate_id") @db.VarChar(50)
  BallotResultDetails_VoteCount   Int       @default(0) @map("ballot_result_details_vote_count")
  BallotResultDetails_Percentage  Float     @default(0) @map("ballot_result_details_percentage")
  BallotResultDetails_Rank        Int       @default(0) @map("ballot_result_details_rank")
  BallotResultDetails_LastUpdated DateTime  @default(now()) @map("ballot_result_details_last_updated")
  ballot                          Ballot    @relation(fields: [BallotResultDetails_BallotId], references: [id], map: "ballot_result_details_ballot_fkey")
  ballotResults                   BallotResults @relation(fields: [BallotResultDetails_BallotId], references: [BallotResults_BallotId])
  candidate                       Candidate @relation(fields: [BallotResultDetails_CandidateId], references: [id], map: "ballot_result_details_candidate_fkey")
  position                        Position  @relation(fields: [BallotResultDetails_PositionId], references: [id], map: "ballot_result_details_position_fkey")

  @@unique([BallotResultDetails_BallotId, BallotResultDetails_PositionId, BallotResultDetails_CandidateId], map: "ballot_result_details_ballot_result_details_ballot_id_ballot_re")
  @@map("ballot_result_details")
}

model BallotTemplate {
  id                         String    @id @db.VarChar(50)
  BallotTemplate_Name        String    @map("ballot_template_name") @db.VarChar(255)
  BallotTemplate_Description String?   @map("ballot_template_description")
  BallotTemplate_Data        Json      @map("ballot_template_data")
  BallotTemplate_IsPublic    Boolean   @default(false) @map("ballot_template_is_public")
  BallotTemplate_CreatedBy   String    @map("ballot_template_created_by") @db.VarChar(50)
  BallotTemplate_CreatedAt   DateTime  @default(now()) @map("ballot_template_created_at")
  BallotTemplate_UpdatedAt   DateTime  @updatedAt @map("ballot_template_updated_at")
  BallotTemplate_DeletedAt   DateTime? @map("ballot_template_deleted_at")
  BallotTemplate_IsDeleted   Boolean   @default(false) @map("ballot_template_is_deleted")
  createdByAdmin             Admin     @relation(fields: [BallotTemplate_CreatedBy], references: [id])

  @@map("ballot_templates")
}

model AdminLoginLog {
  id         String    @id @db.VarChar(50)
  adminId    String    @map("admin_id") @db.VarChar(50)
  loginTime  DateTime  @map("login_time")
  logoutTime DateTime? @map("logout_time")
  duration   Int?      @map("duration")
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent")
  sessionId  String?   @map("session_id") @db.VarChar(255)
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  admin      Admin     @relation(fields: [adminId], references: [id])

  @@map("admin_login_logs")
}

model UserLoginLog {
  id         String    @id @db.VarChar(50)
  userId     String    @map("user_id") @db.VarChar(50)
  loginTime  DateTime  @map("login_time")
  logoutTime DateTime? @map("logout_time")
  duration   Int?      @map("duration")
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent")
  sessionId  String?   @map("session_id") @db.VarChar(255)
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       Voter     @relation(fields: [userId], references: [id])

  @@map("user_login_logs")
}

enum BallotStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

enum Role {
  SUPERADMIN
  ADMIN
}
