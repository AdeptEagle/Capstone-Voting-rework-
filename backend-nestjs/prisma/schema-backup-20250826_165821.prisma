// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @db.VarChar(50)
  username  String   @unique @db.VarChar(255)
  email     String?  @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  elections   Election[]
  departments Department[]
  courses     Course[]

  @@map("admins")
}

model Department {
  id          String   @id @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdBy   String
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  admin   Admin     @relation(fields: [createdBy], references: [id])
  courses Course[]
  voters  Voter[]
  candidates Candidate[]

  @@map("departments")
}

model Course {
  id           String   @id @db.VarChar(50)
  name         String   @db.VarChar(255)
  code         String   @unique @db.VarChar(50)
  description  String?  @db.Text
  departmentId String
  createdBy    String
  isDeleted    Boolean  @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  department Department @relation(fields: [departmentId], references: [id])
  admin      Admin     @relation(fields: [createdBy], references: [id])
  voters     Voter[]
  candidates Candidate[]

  @@map("courses")
}

model Position {
  id          String   @id @db.VarChar(50)
  title       String   @db.VarChar(255)
  description String?  @db.Text
  voteLimit   Int      @default(1) @db.Integer
  displayOrder Int     @default(0) @db.Integer
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  candidates Candidate[]
  votes      Vote[]
  electionPositions ElectionPosition[]

  @@map("positions")
}

model Candidate {
  id          String   @id @db.VarChar(50)
  name        String   @db.VarChar(255)
  email       String   @db.VarChar(255)
  studentId   String   @unique @db.VarChar(50)
  photo       String?  @db.VarChar(255)
  manifesto   String?  @db.Text
  positionId  String
  departmentId String?
  courseId    String?
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  position   Position   @relation(fields: [positionId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  course     Course?    @relation(fields: [courseId], references: [id])
  votes      Vote[]
  electionCandidates ElectionCandidate[]

  @@map("candidates")
}

model Voter {
  id           String   @id @db.VarChar(50)
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  studentId    String   @unique @db.VarChar(50)
  password     String?  @db.VarChar(255)
  departmentId String?
  courseId     String?
  hasVoted     Boolean  @default(false)
  isDeleted    Boolean  @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  department Department? @relation(fields: [departmentId], references: [id])
  course     Course?    @relation(fields: [courseId], references: [id])
  votes      Vote[]
  auditLogs  AuditLog[]

  @@map("voters")
}

model Election {
  id        String   @id @db.VarChar(50)
  title     String   @db.VarChar(255)
  description String? @db.Text
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  status    String   @default("draft") @db.VarChar(50) // draft, active, paused, ended
  isDeleted Boolean  @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdBy String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  admin   Admin @relation(fields: [createdBy], references: [id])
  votes   Vote[]
  electionPositions ElectionPosition[]
  electionCandidates ElectionCandidate[]
  auditLogs AuditLog[]

  @@map("elections")
}

model Vote {
  id               String   @id @db.VarChar(50)
  voterId          String
  candidateId      String
  electionId       String
  positionId       String
  verificationCode String?  @db.VarChar(255) // For vote verification
  auditHash        String?  @db.VarChar(255) // For integrity verification
  ipAddress        String?  @db.VarChar(45)  // IP address of voter
  userAgent        String?  @db.Text          // User agent string
  sessionId        String?  @db.VarChar(255) // Session identifier
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  voter     Voter     @relation(fields: [voterId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])
  election  Election  @relation(fields: [electionId], references: [id])
  position  Position  @relation(fields: [positionId], references: [id])

  @@unique([voterId, electionId, positionId, candidateId])
  @@map("votes")
}

model ElectionPosition {
  id         String   @id @db.VarChar(50)
  electionId String
  positionId String
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  election Election @relation(fields: [electionId], references: [id])
  position Position @relation(fields: [positionId], references: [id])

  @@unique([electionId, positionId])
  @@map("election_positions")
}

model ElectionCandidate {
  id          String   @id @db.VarChar(50)
  electionId  String
  candidateId String
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  election  Election  @relation(fields: [electionId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@unique([electionId, candidateId])
  @@map("election_candidates")
}

model PasswordResetToken {
  id        String   @id @db.VarChar(50)
  email     String   @unique @db.VarChar(255)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @db.VarChar(50)
  eventType  String   @db.VarChar(50) // VOTE_CAST, VOTE_VERIFIED, LOGIN_ATTEMPT, etc.
  timestamp  DateTime @default(now())
  userId     String?  @db.VarChar(50)  // ID of user who triggered the event
  electionId String?  @db.VarChar(50)  // ID of election if applicable
  action     String   @db.VarChar(255) // Human-readable action description
  details    Json?    // Additional event details
  metadata   Json?    // IP address, user agent, session info
  severity   String   @db.VarChar(20)  // LOW, MEDIUM, HIGH, CRITICAL
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user     Voter?    @relation(fields: [userId], references: [id])
  election Election? @relation(fields: [electionId], references: [id])

  @@map("audit_logs")
}

enum Role {
  SUPERADMIN
  ADMIN
} 